# Local Firebase emulators; remove emulator settings for production.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-axpm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-axpm
NEXT_PUBLIC_USE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-axpm
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-axpm.appspot.com
APP_ORIGIN=http://localhost:3000
# Production: comma-separated exact email addresses and/or Workspace domains.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# Optional shared operational workspace for every authorized account.
AXPM_WORKSPACE_UID=
# Server-only Gemini API. Never prefix this key with NEXT_PUBLIC_.
# Install Hermes with npm run hermes:setup; Docker includes the runtime.
AGENT_ENGINE=hermes
AGENT_PROVIDER=gemini
AGENT_MODEL=
GEMINI_API_KEY=
# npm run hermes:setup sets the local path. Docker uses /opt/hermes-venv/bin/hermes.
HERMES_BIN=
# Optional built-in adapters (explicit AGENT_ENGINE=hermes only).
# Keyless Drive/Sheets: share only this root with the runtime service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_ROOT_ID=
AXPM_PROGRAM_NAME=
AXPM_MASTER_SPREADSHEET_ID=
AXPM_MASTER_SHEET_ID=
AXPM_MASTER_SHEET_TITLE=
AXPM_MASTER_DASHBOARD_RANGE=
AXPM_DRIVE_ROOT_ID=
AXPM_REPORT_FOLDER_ID=
AXPM_DEFAULT_CAMPUS=
AXPM_GMAIL_QUERY=label:AXPM/첨부수집 has:attachment newer_than:30d
AXPM_GMAIL_ACCOUNT=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
# Local emulator only; uses current gcloud identity to impersonate the account above.
AXPM_LOCAL_GCLOUD_AUTH=false
# Generate a separate long random value for Cloud Scheduler authentication.
CRON_SECRET=
