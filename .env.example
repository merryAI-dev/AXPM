# Local Firebase emulators; remove emulator settings for production.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-axpm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-axpm
NEXT_PUBLIC_USE_EMULATORS=true
FIREBASE_PROJECT_ID=demo-axpm
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-axpm.appspot.com
APP_ORIGIN=http://localhost:3000
# Production: comma-separated exact email addresses allowed to sign in.
ALLOWED_EMAILS=
# Hermes + Gemini. Set the model ID available to your Gemini API project.
AGENT_ENGINE=hermes
AGENT_PROVIDER=gemini
AGENT_MODEL=
GEMINI_API_KEY=
HERMES_BIN=/absolute/path/to/AXPM/private/hermes-venv/bin/hermes
# Optional built-in adapters (explicit AGENT_ENGINE=builtin only).
ANTHROPIC_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Keyless Drive/Sheets: share only this root with the runtime service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_ROOT_ID=
# Local emulator only; uses current gcloud identity to impersonate the account above.
AXPM_LOCAL_GCLOUD_AUTH=false
# Google Cloud OAuth Web client; callback = APP_ORIGIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32. Keep in Secret Manager in production.
TOKEN_ENCRYPTION_KEY=
# Generate a separate long random value for Cloud Scheduler authentication.
CRON_SECRET=
