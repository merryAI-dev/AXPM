{
  "name": "axpm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-axpm --only auth,firestore,storage",
    "import:inspect": "tsx scripts/inspect.ts",
    "check:integration": "tsx scripts/integration-check.ts && tsx scripts/workspace-check.ts",
    "deploy:plan": "node scripts/deploy.mjs",
    "worker": "node scripts/worker.mjs",
    "agent:setup": "tsx scripts/setup-local-agent.ts",
    "agent:ask": "node scripts/ask-agent.mjs",
    "hermes:setup": "node scripts/setup-hermes.mjs",
    "hermes": "node scripts/hermes.mjs",
    "check:mcp": "tsx scripts/check-http-mcp.ts",
    "check:drive": "tsx scripts/check-live-drive.ts",
    "gemini:connect": "node scripts/connect-gemini.mjs",
    "check:hermes": "tsx scripts/check-hermes.ts",
    "check:viewer": "tsx scripts/check-viewer.ts",
    "hwpx:setup": "node scripts/setup-hwpx.mjs",
    "hwpx": "node scripts/hwpx.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "googleapis": "^181.0.0",
    "jszip": "^3.10.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
