{
  "name": "axpm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-axpm --only auth,firestore,storage",
    "deploy:plan": "node scripts/deploy.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "worker": "node scripts/worker.mjs",
    "agent:ask": "node scripts/ask-agent.mjs",
    "hermes:setup": "node scripts/setup-hermes.mjs",
    "hermes": "node scripts/hermes.mjs",
    "check:cloud": "tsx scripts/check-cloud.ts",
    "gemini:connect": "node scripts/connect-gemini.mjs",
    "monitor:reports": "tsx scripts/report-monitor.ts",
    "monitor:install": "node scripts/install-report-monitor.mjs",
    "sync:reports": "tsx scripts/sync-reports.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "googleapis": "^181.0.0",
    "jszip": "^3.10.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
