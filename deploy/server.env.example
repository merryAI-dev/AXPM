# Public Firebase web configuration: set BEFORE npm run build.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
NEXT_PUBLIC_USE_EMULATORS=false
# Server runtime configuration. Credentials must be supplied through host secrets.
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
APP_ORIGIN=https://YOUR_APP_DOMAIN
ALLOWED_EMAILS=operator@example.com
ALLOWED_DOMAINS=example.com
AXPM_WORKSPACE_UID=YOUR_FIREBASE_OPERATOR_UID
GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_RUNTIME_SERVICE_ACCOUNT
GOOGLE_SERVICE_ACCOUNT_ROOT_ID=YOUR_SHARED_DRIVE_ROOT
AXPM_PROGRAM_NAME=YOUR_PROGRAM_NAME
AXPM_MASTER_SPREADSHEET_ID=YOUR_MASTER_SPREADSHEET_ID
AXPM_MASTER_SHEET_ID=YOUR_MASTER_TAB_ID
AXPM_MASTER_SHEET_TITLE=YOUR_MASTER_TAB_TITLE
AXPM_MASTER_DASHBOARD_RANGE=J98:S130
AXPM_DRIVE_ROOT_ID=YOUR_DRIVE_ROOT_ID
AXPM_REPORT_FOLDER_ID=YOUR_REPORT_FOLDER_ID
AXPM_DEFAULT_CAMPUS=YOUR_DEFAULT_CAMPUS
AXPM_GMAIL_QUERY=label:AXPM/첨부수집 has:attachment newer_than:30d
AXPM_GMAIL_ACCOUNT=YOUR_INTAKE_ACCOUNT@example.com
GOOGLE_OAUTH_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID
AGENT_ENGINE=hermes
AGENT_PROVIDER=gemini
AGENT_MODEL=YOUR_GEMINI_MODEL_ID
GEMINI_API_KEY=
CRON_SECRET=

# Docker 이미지 기본 경로. 직접 설치 시 npm run hermes:setup이 설정합니다.
HERMES_BIN=/opt/hermes-venv/bin/hermes
